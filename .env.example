NODE_ENV=local

# `bun run dev` serves named portless `.localhost` URLs (branch-prefixed in a worktree); `PORTLESS=0` uses the plain localhost ports below.

# -------------------- Server variables --------------------

HONO_APP_URL=http://localhost:4000
HONO_TRUSTED_ORIGINS=http://localhost:3000
# Identity provider origins SSO may fetch an OIDC discovery document from, comma separated.
# Separate from HONO_TRUSTED_ORIGINS on purpose: that list is browsers we serve, this one is servers
# we call, and an entry here must never widen what a passkey ceremony accepts.
# BETTER_AUTH_SSO_ORIGINS=https://your-tenant.okta.com
HONO_RATE_LIMIT=60 # allow 60 req/min (default) and twice that for authenticated users
HONO_RATE_LIMIT_WINDOW_MS=60000 # 1 minute (default)

# Generate using `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Optional: the WebAuthn relying-party id for passkeys, a bare hostname with no protocol or port.
# Defaults to the web origin's host, which is right for localhost and for a *.vercel.app host (a
# public suffix cannot be shortened). Set it to the shared parent only when web and api sit on
# sibling subdomains of a custom domain, e.g. example.com for app.example.com + api.example.com.
# Changing it invalidates every passkey already registered.
BETTER_AUTH_RP_ID=

# Optional (local dev only): set to `true` to enable the agent sign-in route (`/api/agents/sign-in-as`), which mints an admin session for AI-agent testing. Leave blank (or `false`) everywhere else, including production; the route stays unmounted.
AGENT_SIGNIN_ENABLED=

# Optional: GitHub OAuth (`https://github.com/settings/developers`). Leave blank to hide the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Google OAuth (`https://console.cloud.google.com/apis/credentials`). Leave blank to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate using `bunx pglaunch -k`
POSTGRES_URL=

# -------------------- Client variables --------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: PostHog Analytics (https://zerostarter.dev/docs/manage/analytics)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Optional: User feedback (https://zerostarter.dev/docs/manage/analytics)
NEXT_PUBLIC_USERJOT_URL=
